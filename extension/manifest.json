{
  "manifest_version": 3,
  "name": "Tab Chat - 同じページで匿名チャット",
  "version": "1.0.0",
  "description": "同じURLを開いている人数をリアルタイム表示し、匿名でチャットできます。",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Chat"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
