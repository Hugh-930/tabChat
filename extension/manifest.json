{
  "manifest_version": 3,
  "name": "Tab Chat - 同じページで匿名チャット",
  "version": "1.2.0",
  "description": "同じURLを開いている人数をリアルタイム表示し、匿名でチャットできます。ページ内に常駐するウィジェット型。",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.onrender.com/*"
  ],
  "action": {
    "default_title": "Tab Chat を開く / 最小化"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/socket.io.min.js", "roomId.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
